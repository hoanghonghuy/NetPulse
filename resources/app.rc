// Speed Test Dialog
IDD_SPEED_TEST_DIALOG DIALOGEX 0, 0, 280, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Speed Test"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // Start button and progress bar
    PUSHBUTTON      "Start Test",IDC_SPEED_START_BUTTON,95,10,90,18
    CONTROL         "",IDC_SPEED_TEST_PROGRESS,"msctls_progress32",PBS_SMOOTH | WS_BORDER,40,32,200,12
    LTEXT           "",IDC_SPEED_STATUS_LABEL,95,48,90,10,SS_CENTER
    
    // Results group box
    GROUPBOX        "Results",IDC_SPEED_RESULT_GROUP,10,62,260,50
    LTEXT           "Download:",IDC_SPEED_DOWNLOAD_LABEL,20,77,40,10
    LTEXT           "--",IDC_SPEED_DOWNLOAD_VALUE,65,77,60,10
    LTEXT           "Upload:",IDC_SPEED_UPLOAD_LABEL,130,77,35,10
    LTEXT           "--",IDC_SPEED_UPLOAD_VALUE,168,77,60,10
    LTEXT           "Ping:",IDC_SPEED_PING_LABEL,20,92,25,10
    LTEXT           "--",IDC_SPEED_PING_VALUE,65,92,60,10
    
    // History list
    LTEXT           "History:",IDC_SPEED_HISTORY_LABEL,10,118,30,10
    CONTROL         "",IDC_SPEED_HISTORY_LIST,"SysListView32",WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL,10,130,260,45
    
    // Close button
    PUSHBUTTON      "Close",IDCANCEL,210,180,60,14
END

