    LTEXT           "",IDC_TODAY_DOWN,70,20,100,8
    LTEXT           "Upload:",IDC_DASHBOARD_LABEL_UPLOAD_T,15,33,50,8
    LTEXT           "",IDC_TODAY_UP,70,33,100,8

    // This month (right column)
    LTEXT           "This month:",IDC_DASHBOARD_LABEL_MONTH,180,7,70,8
