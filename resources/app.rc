    LTEXT           "",IDC_MONTH_DOWN,260,20,90,8
    LTEXT           "Upload:",IDC_DASHBOARD_LABEL_UPLOAD_M,180,33,60,8
    LTEXT           "",IDC_MONTH_UP,260,33,90,8

    // Chart control (moved down to make room for navigation buttons)
    CONTROL         "",IDC_DASHBOARD_CHART,"STATIC",SS_OWNERDRAW | SS_NOTIFY | WS_CHILD | WS_VISIBLE | WS_BORDER,7,65,346,60
    CONTROL         "",IDC_RECENT_LIST,"SysListView32",WS_TABSTOP | WS_BORDER | WS_VSCROLL | WS_HSCROLL | LVS_REPORT | LVS_SHOWSELALWAYS,7,130,346,85
    PUSHBUTTON      "Export CSV...",IDC_DASHBOARD_BUTTON_EXPORT,7,220,55,14
    PUSHBUTTON      "Export Chart...",IDC_DASHBOARD_EXPORT_CHART,65,220,55,14
    PUSHBUTTON      "Manage history...",IDC_HISTORY_MANAGE,125,220,76,14
    PUSHBUTTON      "Refresh",IDC_DASHBOARD_REFRESH,206,220,50,14
