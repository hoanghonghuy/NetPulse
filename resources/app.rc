#ifndef NETPULSE_SKIP_RC_MANIFEST
1 RT_MANIFEST "app.manifest"
#endif

// ============================================================================
// DIALOG RESOURCES (Optional - for future use)
// ============================================================================

IDD_ABOUT_DIALOG DIALOGEX 0, 0, 250, 120
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NetPulse"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // ICON COMMENTED OUT - IDI_APP_ICON not defined yet
    // ICON            IDI_APP_ICON,IDC_STATIC,7,7,21,20
    LTEXT           "NetPulse",IDC_STATIC,40,10,200,8,SS_NOPREFIX
    LTEXT           "Version 2.4.0",IDC_VERSION_TEXT,40,25,200,8
    LTEXT           "A lightweight network traffic monitor for Windows.",IDC_STATIC,40,40,200,8
    LTEXT           "Copyright (C) 2025 - MIT License",IDC_COPYRIGHT_TEXT,40,55,200,8
    CONTROL         "<a href=""https://github.com/hoanghonghuy/NetPulse"">GitHub: hoanghonghuy/NetPulse</a>",IDC_GITHUB_LINK,"SysLink",WS_TABSTOP | WS_GROUP,40,70,200,10
    DEFPUSHBUTTON   "OK",IDOK,95,95,60,14,WS_GROUP
END

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 280, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NetPulse Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // Tab Control
    CONTROL         "",IDC_SETTINGS_TAB,"SysTabControl32",WS_TABSTOP,7,7,266,180

    // === GENERAL TAB (index 0) ===
    LTEXT           "Language:",IDC_SETTINGS_LABEL_LANGUAGE,15,32,50,8
    COMBOBOX        IDC_LANGUAGE_COMBO,75,30,90,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Start with Windows",IDC_AUTOSTART_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,50,100,10
    CONTROL         "Run as Administrator",IDC_AUTOSTART_ADMIN_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,50,100,10
    CONTROL         "Enable history logging",IDC_ENABLE_LOGGING_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,65,100,10
    CONTROL         "Enable debug logging",IDC_DEBUG_LOGGING_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,80,100,10
    CONTROL         "Connection notifications",IDC_CONNECTION_NOTIFY_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,95,110,10

    // === DISPLAY TAB (index 1) ===
    LTEXT           "Theme:",IDC_SETTINGS_LABEL_THEME,15,32,60,8
    COMBOBOX        IDC_THEME_MODE_COMBO,80,30,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Update Interval:",IDC_SETTINGS_LABEL_INTERVAL,15,50,60,8
    COMBOBOX        IDC_UPDATE_INTERVAL_COMBO,80,48,100,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Speed Unit:",IDC_SETTINGS_LABEL_SPEED_UNIT,15,68,50,8
    COMBOBOX        IDC_DISPLAY_UNIT_COMBO,75,66,100,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Overlay Font Size:",IDC_FONT_SIZE_LABEL,15,86,70,8
    COMBOBOX        IDC_OVERLAY_FONT_SIZE_COMBO,90,84,50,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Overlay Colors:",IDC_OVERLAY_COLOR_LABEL,15,104,60,8
    COMBOBOX        IDC_OVERLAY_COLOR_COMBO,80,102,130,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Floating Window:",IDC_SETTINGS_GROUP_FLOATING,15,122,60,8
    CONTROL         "Network",IDC_FLOATING_SHOW_NETWORK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,80,120,45,10
    CONTROL         "CPU",IDC_FLOATING_SHOW_CPU_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,130,120,30,10
    CONTROL         "RAM",IDC_FLOATING_SHOW_RAM_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,165,120,30,10
    CONTROL         "Ping",IDC_FLOATING_SHOW_PING_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,200,120,30,10
    CONTROL         "Data Today",IDC_FLOATING_SHOW_DATA_TODAY_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,80,135,80,10
    CONTROL         "Sparkline",IDC_FLOATING_SHOW_SPARKLINE_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,165,135,50,10
    CONTROL         "VPN",IDC_FLOATING_SHOW_VPN_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,220,135,30,10
    CONTROL         "IP",IDC_FLOATING_SHOW_IP_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,255,135,20,10
    
    // Tray Icon Group
    LTEXT           "Tray Icon:",IDC_SETTINGS_GROUP_TRAY,15,152,60,8
    CONTROL         "Pulse Animation",IDC_TRAY_ANIMATION_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,80,150,70,10
    LTEXT           "Trigger at:",IDC_TRAY_ANIMATION_THRESHOLD_LABEL,155,152,35,8
    COMBOBOX        IDC_TRAY_ANIMATION_THRESHOLD,195,150,45,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    // Sparkline Settings
    LTEXT           "Chart Time Range:",IDC_SPARKLINE_TIME_RANGE_LABEL,15,170,70,8
    COMBOBOX        IDC_SPARKLINE_TIME_RANGE_COMBO,90,168,60,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // === ADVANCED TAB (index 2) ===
    LTEXT           "Network Interface:",IDC_SETTINGS_LABEL_MONITOR,15,32,70,8
    COMBOBOX        IDC_INTERFACE_COMBO,90,30,150,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Auto-delete history older than:",IDC_HISTORY_TRIM_LABEL,15,50,110,8
    COMBOBOX        IDC_HISTORY_AUTO_TRIM_COMBO,130,48,80,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Ping Target:",IDC_PING_TARGET_LABEL,15,68,50,8
    EDITTEXT        IDC_PING_TARGET_EDIT,70,66,80,12,ES_AUTOHSCROLL
    LTEXT           "Ping Interval:",IDC_PING_INTERVAL_LABEL,160,68,50,8
    COMBOBOX        IDC_PING_INTERVAL_COMBO,215,66,45,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Hotkey:",IDC_HOTKEY_LABEL,15,86,35,8
    COMBOBOX        IDC_HOTKEY_COMBO,55,84,100,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    
    // Data Usage Alerts
    CONTROL         "Enable data usage alerts",IDC_DATA_USAGE_ENABLE_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,102,160,10
    LTEXT           "Monthly quota (GB):",IDC_DATA_USAGE_QUOTA_LABEL,15,118,70,8
    EDITTEXT        IDC_DATA_USAGE_QUOTA_EDIT,90,116,50,12,ES_AUTOHSCROLL

    // Bottom buttons (always visible)
    PUSHBUTTON      "Open log file...",IDC_SETTINGS_BUTTON_OPEN_LOG,7,195,70,14
    PUSHBUTTON      "OK",IDOK,115,195,50,14
    PUSHBUTTON      "Apply",IDC_SETTINGS_BUTTON_APPLY,170,195,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,225,195,50,14
END

IDD_DASHBOARD_DIALOG DIALOGEX 0, 0, 360, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Network Usage Dashboard"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
